{
  "name": "@mira/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:model:live": "vitest run --config vitest.live.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-pgvector": "^0.0.15",
    "@fastify/cors": "^11.0.1",
    "@mira/contracts": "*",
    "@mira/domain": "*",
    "@mira/model-gateway": "*",
    "@mira/prompts": "*",
    "@mira/rag": "*",
    "argon2": "^0.43.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.3.3",
    "jose": "^6.0.11",
    "pgvector": "^0.3.0",
    "postgres": "^3.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}

# Server-only model configuration. Never prefix these values with NEXT_PUBLIC_ or EXPO_PUBLIC_.
# mock | local | remote (legacy alias: live). No automatic remote fallback.
MODEL_MODE=mock

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_PREMIUM_MODEL=deepseek-v4-pro

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_DEFAULT_MODEL=qwen3.5:latest
OLLAMA_EMBED_MODEL=bge-m3

MODEL_REQUEST_TIMEOUT_MS=60000
MODEL_MAX_OUTPUT_TOKENS=800
MODEL_DAILY_REMOTE_TOKEN_BUDGET=200000
MODEL_LIVE_TESTS_ENABLED=false

# API
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
LOGIN_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Database: set DATABASE_URL for Postgres, or USE_PGLITE=true for embedded local/dev
# DATABASE_URL=postgres://mira:mira@127.0.0.1:5432/mira
USE_PGLITE=true
